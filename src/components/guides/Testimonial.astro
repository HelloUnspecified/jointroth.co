---
// One reader's words. A flat card: the quote in serif with a terracotta opening
// mark, the attribution underneath in sans. `placeholder` renders the same card
// with a quiet tag, so a mocked-up section can't be mistaken for the real thing.
interface Props {
  quote: string;
  name: string;
  /** e.g. "Married 12 years" or "Madison, WI". */
  detail?: string;
  placeholder?: boolean;
  class?: string;
}
const {
  quote,
  name,
  detail,
  placeholder = false,
  class: className,
} = Astro.props;
---

<figure class:list={["tm", placeholder && "tm--placeholder", className]}>
  {placeholder && <span class="tm__tag">Placeholder</span>}
  <blockquote class="tm__quote">
    <span class="tm__mark" aria-hidden="true">“</span>
    <p>{quote}</p>
  </blockquote>
  <figcaption class="tm__who">
    <span class="tm__name">{name}</span>
    {detail && <span class="tm__detail">{detail}</span>}
  </figcaption>
</figure>

<style>
  .tm {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: clamp(22px, 3vw, 28px);
  }
  .tm__tag {
    position: absolute;
    top: 12px;
    right: 14px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-pill);
    padding: 3px 8px;
  }
  .tm--placeholder {
    border-style: dashed;
  }

  .tm__quote {
    position: relative;
    margin: 0;
    padding-left: 22px;
    flex: 1;
  }
  .tm__mark {
    position: absolute;
    left: -4px;
    top: -0.28em;
    font-family: var(--font-serif);
    font-size: 44px;
    line-height: 1;
    color: var(--color-accent);
  }
  .tm__quote p {
    font-family: var(--font-serif);
    font-size: clamp(16.5px, 1.9vw, 18px);
    line-height: 1.58;
    color: var(--color-text);
    margin: 0;
    text-wrap: pretty;
  }
  .tm--placeholder .tm__quote p {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .tm__who {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: baseline;
    padding-left: 22px;
    font-family: var(--font-sans);
    font-size: 13px;
  }
  .tm__name {
    font-weight: 500;
    color: var(--color-text);
  }
  .tm__detail {
    color: var(--color-text-tertiary);
  }
</style>
