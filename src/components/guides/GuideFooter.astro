---
import LanternMark from "../../elements/LanternMark.astro";

const year = new Date().getFullYear();
---

<footer class="gf">
  <div class="g-wrap gf__inner">
    <a href="/" class="gf__brand" aria-label="Troth home">
      <LanternMark size={20} tone="brand" />
      <span>Troth</span>
    </a>
    <p class="gf__line">
      A private, encrypted home for your marriage. Built by Clark and Carrie
      Sell. Coming to iPhone.
    </p>
    <div class="gf__links">
      <a href="/">jointroth.co</a>
      <a href="mailto:clark@jointroth.co">clark@jointroth.co</a>
      <span>&copy; {year} Troth</span>
    </div>
  </div>
</footer>

<style>
  .gf {
    border-top: 1px solid var(--color-border);
    padding-block: clamp(32px, 5vw, 48px);
  }
  .gf__inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .gf__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    align-self: flex-start;
    text-decoration: none;
    color: var(--color-text);
  }
  .gf__brand span {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    padding-left: 0.32em;
  }
  .gf__line {
    font-family: var(--font-serif);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 34rem;
    text-wrap: pretty;
  }
  .gf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-text-tertiary);
  }
  .gf__links a {
    color: inherit;
    text-decoration: none;
  }
  .gf__links a:hover {
    color: var(--color-accent);
  }
</style>
