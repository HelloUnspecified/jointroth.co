---
// Shell for every editorial page: the homepage, /welcome, /guides and
// /newsletter. Same <head>, tokens, and fonts as Layout — full-bleed,
// responsive, with the sticky header and the footer. The editorial CSS is
// imported here so a page that doesn't use this shell never loads it.
import Layout from "./Layout.astro";
import GuideHeader from "../components/guides/GuideHeader.astro";
import GuideFooter from "../components/guides/GuideFooter.astro";
import "../css/troth-guide.css";

interface NavLink {
  label: string;
  href: string;
}
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  headerCta?: string;
  headerCtaHref?: string;
  nav?: NavLink[];
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType = "article",
  noindex,
  jsonLd,
  headerCta,
  headerCtaHref,
  nav,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogType={ogType}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <slot name="head" slot="head" />
  {
    /* Mark JS before first paint so revealed sections never flash in and out. */
  }
  <script is:inline>
    document.documentElement.classList.add("g-js");
  </script>
  <div class="g-page">
    <GuideHeader cta={headerCta} ctaHref={headerCtaHref} nav={nav} />
    <main class="g-main">
      <slot />
    </main>
    <GuideFooter />
  </div>
</Layout>

<style is:global>
  /* Editorial pages scroll normally; be explicit so nothing leaks in. */
  html:has(.g-page) {
    scroll-snap-type: none;
    scroll-padding-top: 78px;
  }
</style>

<script>
  const root = document.documentElement;

  /* Header hairline + header CTA appear once you're past the fold. */
  const onScroll = () =>
    root.classList.toggle("g-scrolled", window.scrollY > 240);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  /* Sections rise into place as they arrive — starting just before they
     enter the viewport, so the reader never meets half-faded text. */
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add("is-shown");
          io.unobserve(e.target);
        });
      },
      { threshold: 0, rootMargin: "0px 0px 12% 0px" },
    );
    document.querySelectorAll(".g-reveal").forEach((el) => io.observe(el));
  } else {
    document
      .querySelectorAll(".g-reveal")
      .forEach((el) => el.classList.add("is-shown"));
  }
</script>
