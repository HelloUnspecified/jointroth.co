---
import "../css/tailwind.css";
import SEO from "../components/functional/SEO.astro";
// The hero headline is Newsreader 400 — it's the LCP element on both page
// families. Preloading the one file it needs removes the round trip that
// @fontsource's CSS would otherwise have to be parsed before starting.
import newsreader400 from "@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, ogImageAlt, ogType, noindex, jsonLd } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <!-- Icons, all derived from favicon.svg by scripts/build-icons.mjs.
         .ico first as the universal fallback — Google Search doesn't accept an
         SVG favicon (ICO/PNG/JPEG/GIF/BMP only) and Safari has never read a
         WebP one, so without it there's no icon beside a search result. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={newsreader400}
      crossorigin
    />

    <meta name="color-scheme" content="light dark" />
    <!-- Pre-paint setup (no flash): apply the Lamplight preference before the
         first paint. A saved choice wins; with none, follow the system. -->
    <script is:inline>
      (function () {
        var el = document.documentElement;
        var dark = false;
        try {
          var saved = localStorage.getItem("troth-theme");
          dark =
            saved === "dark" ||
            (saved === null &&
              window.matchMedia &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
        } catch (e) {}
        if (dark) {
          el.classList.add("troth-dark");
          el.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <!-- Page-specific head tags (feed links, article: meta). -->
    <slot name="head" />
  </head>
  <body class="font-sans antialiased">
    <slot />
    <style is:global>
      /* Anchor jumps glide, unless the reader asked for no motion. */
      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }
      }
      body {
        margin: 0;
        background: var(--color-canvas);
        color: var(--color-text);
        -webkit-font-smoothing: antialiased;
        transition:
          background var(--dur-considered) var(--ease-troth),
          color var(--dur-considered) var(--ease-troth);
      }
    </style>
  </body>
</html>
