---
// /welcome — where every waitlist signup lands. The job of this page is the
// spouse invite: Troth only works with two, so this is the referral moment.
// Posts { email, ref: "spouse" } to /api/subscribe.
//
//   ?already=1  the server found them already on the waitlist → say so. There's
//               no confirm link this time, so the page must not ask for one.
import GuideLayout from "../layouts/GuideLayout.astro";
import LanternMark from "../elements/LanternMark.astro";
import Eyebrow from "../elements/Eyebrow.astro";
import Button from "../elements/Button.astro";
import TextField from "../elements/TextField.astro";
---

<GuideLayout
  title="You're on the list — Troth"
  description="Thank you for joining the Troth waitlist."
  ogType="website"
  noindex
>
  {/* Runs before the blocks below paint, so neither heading flashes. */}
  <script is:inline>
    (function () {
      try {
        if (new URLSearchParams(location.search).get("already") === "1")
          document.documentElement.classList.add("g-already");
      } catch (e) {}
    })();
  </script>

  <section class="g-wrap g-wrap--narrow g-section welcome">
    <div class="welcome__head">
      <LanternMark size={34} tone="brand" />
      {/* New to the list: the double opt-in ask. */}
      <div class="welcome--new">
        <h1 class="g-h1 welcome__h1">You're on the list.</h1>
        <p class="g-lede welcome__lede">
          Thank you. Please check your inbox in the next minute to confirm. I've
          also written you a note about what happens next.
        </p>
      </div>
      {/* Already on it: nothing to confirm, so say so. */}
      <div class="welcome--already">
        <h1 class="g-h1 welcome__h1">You're already on the list.</h1>
        <p class="g-lede welcome__lede">
          Your place is kept, and there's nothing to confirm this time.
        </p>
      </div>
    </div>

    {/* Invite your spouse — the primary referral moment */}
    <div class="g-note invite">
      <Eyebrow tone="letter">The most important step</Eyebrow>
      <h2 class="g-h2 invite__h2">Invite your spouse.</h2>
      <p class="g-body invite__body">
        Troth only works with the two of you together. Nothing starts until
        you're both in, and we want your spouse's voice in what we build too.
      </p>

      <div class="invite__form">
        <div data-spouse-form-wrap>
          <form data-spouse-form>
            <label class="g-sr" for="spouse-email">Your spouse's email</label>
            <TextField
              type="email"
              id="spouse-email"
              name="email"
              required
              autocomplete="off"
              inputmode="email"
              placeholder="Your spouse's email"
            />
            <Button
              variant="primary"
              size="large"
              type="submit"
              style="width:100%">Send them an invite</Button
            >
            <p class="t-error" data-error role="alert" hidden></p>
          </form>
        </div>
        <div data-spouse-sent hidden class="invite__sent">
          <LanternMark size={18} tone="brand" />
          <span>Invite sent. They'll hear from me shortly.</span>
        </div>
      </div>

      <button
        type="button"
        class="invite__copy"
        data-copy
        data-copied-label="Link copied"
      >
        Or copy the link to send yourself
      </button>

      <p class="g-meta invite__note">
        They'll get an email from me asking them to confirm, then a note about
        what Troth is and what happens next. No pressure, no gimmicks.
      </p>
    </div>

    {/* Know another couple? — softer secondary referral */}
    <div class="spread">
      <Eyebrow tone="tertiary">Spread the word</Eyebrow>
      <h2 class="g-h3 spread__h2">Know another couple?</h2>
      <p class="g-body spread__body">
        We build Troth in partnership with the couples on this list. Every voice
        shapes what we make. If you know another couple who might care about
        what we're building, send them the link.
      </p>
      <Button variant="secondary" data-copy data-copied-label="Link copied"
        >Copy link</Button
      >
    </div>

    {/* Expectation-setting + sign-off */}
    <div class="next">
      <p class="g-body">
        We're opening access to Troth carefully, a few couples at a time as we
        build. When it's your turn, you'll hear from me at least 48 hours
        before.
      </p>
      <p class="g-body next__p">
        Have a question? Reply to any email from me. I read them all.
      </p>
      <p class="g-sign">— Clark</p>
    </div>
  </section>
</GuideLayout>

<style is:global>
  /* Exactly one of the two headings is ever shown. */
  .welcome--already,
  .g-already .welcome--new {
    display: none;
  }
  .g-already .welcome--already {
    display: block;
  }
</style>

<style>
  .welcome__head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .welcome__h1 {
    margin-top: 22px;
    font-size: clamp(36px, 6vw, 56px);
  }
  .welcome__lede {
    margin-top: 18px;
    max-width: 30rem;
  }

  .invite {
    margin-top: clamp(36px, 5vw, 56px);
  }
  .invite__h2 {
    margin-top: 12px;
    font-size: clamp(26px, 3.6vw, 34px);
  }
  .invite__body {
    margin-top: 14px;
    max-width: 32rem;
  }
  .invite__form {
    margin-top: 20px;
    max-width: 26rem;
  }
  .invite__form form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .invite__form :global(.t-input) {
    background: var(--color-bg);
    border-color: var(--color-border-strong);
  }
  .invite__sent {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    padding: 14px 16px;
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.45;
    color: var(--color-text);
  }
  .invite__copy {
    margin-top: 14px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent);
  }
  .invite__copy:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .invite__note {
    margin-top: 16px;
    max-width: 30rem;
  }

  .spread {
    margin-top: clamp(32px, 5vw, 48px);
  }
  .spread__h2 {
    margin-top: 10px;
  }
  .spread__body {
    margin: 12px 0 18px;
    max-width: 34rem;
  }

  .next {
    margin-top: clamp(32px, 5vw, 48px);
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    max-width: 34rem;
  }
  .next__p {
    margin-top: 12px;
  }
</style>

<script>
  function subscribeError(status: number) {
    return status === 429
      ? "A lot of people are joining right now — give it a moment and try again."
      : "Something went wrong on our end. Please try again in a moment.";
  }

  const form = document.querySelector<HTMLFormElement>("[data-spouse-form]");
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[type="email"]');
      const btn = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      const errEl = form.querySelector<HTMLElement>("[data-error]");
      if (!input || !btn) return;
      const original = btn.textContent;
      if (errEl) {
        errEl.textContent = "";
        errEl.hidden = true;
      }
      btn.disabled = true;
      btn.textContent = "Sending…";
      try {
        const res = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: input.value, ref: "spouse" }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          const wrap = document.querySelector<HTMLElement>(
            "[data-spouse-form-wrap]",
          );
          const sent =
            document.querySelector<HTMLElement>("[data-spouse-sent]");
          if (wrap) wrap.hidden = true;
          if (sent) sent.hidden = false;
          return;
        }
        if (errEl) {
          errEl.textContent = subscribeError(res.status);
          errEl.hidden = false;
        }
      } catch {
        if (errEl) {
          errEl.textContent =
            "We couldn't reach the server. Check your connection and try again.";
          errEl.hidden = false;
        }
      }
      btn.disabled = false;
      btn.textContent = original;
    });
  }

  document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
    const original = btn.textContent;
    const copied = btn.dataset.copiedLabel || "Copied";
    btn.addEventListener("click", async () => {
      let label = copied;
      try {
        await navigator.clipboard.writeText("https://jointroth.co");
      } catch {
        // No clipboard access: show the address so it can be typed instead.
        label = "Couldn't copy. It's jointroth.co";
      }
      btn.textContent = label;
      window.setTimeout(() => {
        btn.textContent = original;
      }, 2200);
    });
  });
</script>
