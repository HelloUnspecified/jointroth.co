---
// /pricing — the pricing manifesto, before there's a price. Inspired by
// Sunsama's: say the uncomfortable part first, then the principles behind it.
// Troth isn't a five-dollar app and doesn't compete on price; the page says so
// plainly so nobody is surprised later. When the number is set, put it in
// `price` and it appears at the top. Copy lives in the constants below.
import GuideLayout from "../layouts/GuideLayout.astro";
import GuideForm from "../components/guides/GuideForm.astro";
import Eyebrow from "../elements/Eyebrow.astro";
import { getSiteNav } from "../lib/nav";

const SITE_URL = "https://jointroth.co";
const pageUrl = `${SITE_URL}/pricing/`;
const nav = await getSiteNav();

// The number, once there is one. Null renders the "not set yet" version.
const price = null as { amount: string; per: string } | null;

const meta = {
  title: "What Troth will cost, and why — Troth",
  description:
    "Troth won't be a five-dollar app. One price a year for the two of you, more than an app and less than an hour of counseling. The reasons, before there's a number.",
};

const head = {
  eyebrow: "Pricing, before there's a price",
  heading: "What Troth will cost, and why.",
  lede: "We don't have the number yet. We do know its shape, and we'd rather tell you now than surprise you later.",
  shape: [
    "One price a year, for the two of you.",
    "More than you expect an app to cost.",
    "Less than one hour with a counselor.",
  ],
  notYet:
    "The couples on the waitlist will help us settle the number, and you'll be told what it is before it's your turn. Nobody is charged without knowing first.",
};

const principles = [
  {
    id: "serious",
    heading: "It won't be a five-dollar app.",
    paras: [
      "A marriage is the most serious thing most of us will ever do. The tool that holds it shouldn't be priced like a flashlight app, and it can't be built like one either.",
      "Five-dollar apps are paid for somewhere. Usually by selling what they know about you, or by quietly stopping work on the thing once the download numbers flatten. We've seen both. We won't be either.",
      "Troth is for couples who take the marriage seriously. Not perfectly. Seriously. If that's the two of you, the price will feel like an obvious decision, and if it isn't, no price would.",
    ],
  },
  {
    id: "two",
    heading: "One price, for the two of you.",
    paras: [
      "Troth only works with both of you in it, so it's priced that way: one price covers the couple. No per-person seats, no upgrade to add your spouse.",
      "And it's a year at a time, not a month. You don't subscribe to your marriage month to month, and we'd rather you didn't have to think about Troth that way either.",
    ],
  },
  {
    id: "compare",
    heading: "Compare it to the right things.",
    paras: [
      "Don't compare it to other apps. Compare it to an hour with a marriage counselor: a year of Troth will cost less than that. Compare it to one dinner out, which is what you'd spend rebuilding the evening you forgot to write down.",
      "Then compare it to the thing it's actually for: the twenty years of a marriage that, right now, live nowhere. If a year of Troth costs less than one hour of counseling and it does what it says, it's the best money you'll spend on your marriage this year.",
    ],
  },
  {
    id: "free",
    heading: "Never free forever.",
    paras: [
      "There won't be a free tier. Free tiers are paid for by someone, usually with your data or your attention, and Troth has no ads, no AI, and no one else to bill.",
      "You pay us. That's the whole business. It's also why we can build it so we can't read your room: there's no reason for us to want to.",
    ],
  },
  {
    id: "promise",
    heading: "The price is the promise.",
    paras: [
      "Charging real money means you'll expect real things from us, and you should. A fair price keeps us honest, keeps the two of us at the kitchen table working on it, and keeps Troth off the treadmill of raising money to chase growth we don't need.",
      "We'd rather have a thousand couples who take it seriously than a million who don't.",
    ],
  },
  {
    id: "honest",
    heading: "Whole numbers, no tricks.",
    paras: [
      "No prices ending in ninety-nine. No countdown timers, no “sale ends Sunday,” no discount for pretending to leave. The price is the price, every day of the year, and it's the same one your friends will pay.",
    ],
  },
  {
    id: "lifetime",
    heading: "No lifetime deals.",
    paras: [
      "Marriages are long. So is our obligation to yours. A yearly price keeps both of us invested: you in using it, us in earning the renewal. A one-time payment would let us stop caring, and we don't want the option.",
    ],
  },
  {
    id: "try",
    heading: "Try it before you pay.",
    paras: [
      "Both of you in, the room sealed, a real stretch of using it. Then decide. No card to start, and no reminder emails engineered to make you feel behind.",
    ],
  },
  {
    id: "leave",
    heading: "Leaving is one tap.",
    paras: [
      "Cancel in the app, not by writing to anyone. Your room stays where it always was, in your iCloud, and you'll be able to take everything with you. Nothing we do can hold your marriage hostage, and nothing about our pricing should either.",
    ],
  },
];

const closing = {
  eyebrow: "Coming to iPhone in 2026",
  heading: "You'll know the number before it's your turn.",
  body: "Join the waitlist and you'll hear it from Clark first, with the reasoning, and a say in it.",
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": pageUrl,
    name: "What Troth will cost, and why",
    description: meta.description,
    url: pageUrl,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    publisher: { "@id": `${SITE_URL}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Troth", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Pricing" },
    ],
  },
];
---

<GuideLayout
  title={meta.title}
  description={meta.description}
  ogType="website"
  jsonLd={jsonLd}
  nav={nav}
  headerCta="Join the waitlist"
  headerCtaHref="#join"
>
  <article class="g-wrap g-wrap--narrow g-section pricing">
    <header class="pr__head">
      <Eyebrow tone="accent">{head.eyebrow}</Eyebrow>
      <h1 class="g-h1 pr__h1">{head.heading}</h1>
      <p class="g-lede pr__lede">{head.lede}</p>

      {
        price ? (
          <p class="pr__price">
            <span class="pr__amount">{price.amount}</span>
            <span class="pr__per">{price.per}</span>
          </p>
        ) : (
          <ul class="pr__shape">
            {head.shape.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        )
      }
      <p class="pr__notyet">{head.notYet}</p>
    </header>

    <nav class="pr__toc" aria-label="On this page">
      {principles.map((p) => <a href={`#${p.id}`}>{p.heading}</a>)}
    </nav>

    {
      principles.map((p, i) => (
        <section class="pr__section" id={p.id}>
          <span class="pr__num">{String(i + 1).padStart(2, "0")}</span>
          <h2 class="g-h2 pr__h2">{p.heading}</h2>
          {p.paras.map((para) => (
            <p class="pr__p">{para}</p>
          ))}
        </section>
      ))
    }

    <p class="g-sign pr__sign">— Clark and Carrie</p>

    <section class="pr__join" id="join">
      <Eyebrow tone="tertiary">{closing.eyebrow}</Eyebrow>
      <h2 class="g-h3 pr__join-h2">{closing.heading}</h2>
      <p class="g-body pr__join-body">{closing.body}</p>
      <GuideForm
        redirect="/welcome"
        id="pricing"
        cta="Join the waitlist"
        privacy="You'll also get our letter, Brick by Brick. We'll never share your address. Unsubscribe anytime."
        variant="bare"
        inline
      />
    </section>
  </article>
</GuideLayout>

<style>
  .pr__h1 {
    margin-top: 16px;
    font-size: clamp(36px, 6vw, 56px);
  }
  .pr__lede {
    margin-top: 18px;
  }

  /* The shape of the price, three lines set large. */
  .pr__shape {
    list-style: none;
    margin: clamp(26px, 4vw, 36px) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  .pr__shape li {
    font-family: var(--font-serif);
    font-size: clamp(21px, 2.8vw, 27px);
    line-height: 1.3;
    letter-spacing: -0.008em;
    color: var(--color-text);
    padding: 14px 0 14px 28px;
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }
  .pr__shape li::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0.95em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  /* The number, once there is one. */
  .pr__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: clamp(26px, 4vw, 36px) 0 0;
  }
  .pr__amount {
    font-family: var(--font-serif);
    font-size: clamp(44px, 7vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .pr__per {
    font-family: var(--font-serif);
    font-size: 19px;
    color: var(--color-text-secondary);
  }
  .pr__notyet {
    font-family: var(--font-serif);
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 18px 0 0;
    text-wrap: pretty;
  }

  .pr__toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: clamp(28px, 4vw, 40px);
    padding-block: 16px;
    border-block: 1px solid var(--color-border);
  }
  .pr__toc a {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .pr__toc a:hover {
    color: var(--color-accent);
  }

  .pr__section {
    margin-top: clamp(40px, 6vw, 64px);
    scroll-margin-top: 90px;
  }
  .pr__num {
    display: block;
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-accent);
    font-variant-numeric: lining-nums tabular-nums;
    margin-bottom: 8px;
  }
  .pr__h2 {
    font-size: clamp(26px, 3.6vw, 34px);
  }
  .pr__p {
    font-family: var(--font-serif);
    font-size: 17.5px;
    line-height: 1.66;
    color: var(--color-text-secondary);
    margin: 16px 0 0;
    text-wrap: pretty;
  }
  .pr__p:first-of-type {
    color: var(--color-text);
  }
  .pr__sign {
    margin-top: clamp(32px, 5vw, 48px);
  }

  .pr__join {
    margin-top: clamp(48px, 7vw, 80px);
    padding-top: clamp(32px, 5vw, 48px);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 90px;
  }
  .pr__join-h2 {
    margin: 12px 0 0;
  }
  .pr__join-body {
    margin: 12px 0 20px;
    max-width: 34rem;
  }
</style>
