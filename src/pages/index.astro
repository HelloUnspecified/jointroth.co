  .scene__line {
    font-family: var(--font-serif);
    font-size: clamp(21px, 2.4vw, 25px);
    line-height: 1.28;
    letter-spacing: -0.008em;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }
  .scene__body {
    margin-top: 8px;
