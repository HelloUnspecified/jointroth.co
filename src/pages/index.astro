  }
  .turn__def dt {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--color-accent);
  }
  .turn__def dd {
    font-family: var(--font-serif);
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 6px 0 0;
  }

  /* -------------------------------------------------------------- app -- */
  .app__intro {
    max-width: 40rem;
  }
  .app__h2 {
    margin-top: 14px;
  }
  .app__lede {
    margin-top: 16px;
  }

  /* One layer per row: copy beside its visual, hairline between rows. */
  .layer {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding-block: clamp(36px, 5vw, 64px);
    border-top: 1px solid var(--color-border);
  }
  .layer:first-of-type {
    margin-top: clamp(32px, 5vw, 56px);
  }
  @media (min-width: 992px) {
    .layer {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(48px, 6vw, 96px);
    }
  }
  .layer__name {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .layer__num {
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .layer__verb {
    color: var(--color-accent);
  }
  .layer__h3 {
    margin-top: 12px;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.16;
    text-wrap: balance;
  }
  .layer__body {
    margin-top: 14px;
    max-width: 32rem;
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }
  .kinds li {
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
  }
  .layer__visual {
    min-width: 0;
  }

  /* The paper version of the first exercise, one line. */
  .tryit {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 22px 0 0;
    max-width: 32rem;
    text-wrap: pretty;
  }
  .tryit a {
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .tryit a::after {
    content: " \2192";
  }
  .tryit a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .layer__visual--phone {
    padding-block: clamp(4px, 1.5vw, 16px);
  }

  /* 01 — the first exercise, inside the app. */
  .ex {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 4px 4px 0;
  }
  .ex__who {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-top: 14px;
  }
  .ex__lines {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ex__lines li {
    position: relative;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.35;
    color: var(--color-text-secondary);
    padding: 10px 12px 10px 34px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-wrap: pretty;
  }
  .ex__lines li::before {
    content: "\2606";
    position: absolute;
    left: 12px;
    top: 9px;
    font-size: 15px;
    color: var(--color-text-tertiary);
  }
  .ex__lines li.is-starred {
    color: var(--color-text);
  }
  /* A narrow screen holds the starred lines and the chosen one, nothing more. */
  @media (max-width: 559px) {
    .ex__lines li:not(.is-starred) {
      display: none;
    }
  }
  .ex__lines li.is-starred::before {
    content: "\2605";
    color: var(--color-keepsake);
  }
  .ex__chosen {
    margin-top: 16px;
    padding: 14px 16px 12px;
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-letter);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ex__chosen-label {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-letter);
  }
  .ex__chosen-text {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.32;
    color: var(--color-text);
  }
  .ex__sign {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13.5px;
    color: var(--color-text-tertiary);
    text-align: right;
  }

  /* 02 — the timeline: a rail with six kinds of thing on it. */
  .rail {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: clamp(22px, 3vw, 30px);
    transition: background var(--dur-considered) var(--ease-troth);
  }
  .rail__label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 22px;
  }
  .rail__items {
    list-style: none;
    margin: 0;
    padding: 0 0 0 26px;
    border-left: 1.5px solid var(--color-letter);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .rail__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .rail__dot {
    position: absolute;
    left: calc(-26px - 6px);
    top: 4px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-letter);
    box-shadow: 0 0 0 3px var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rail__dot :global(span) {
    position: absolute;
  }
  .rail__kind {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
  .rail__what {
    font-family: var(--font-serif);
    font-size: 17.5px;
    line-height: 1.3;
    color: var(--color-text);
  }
  /* Wide enough: the rail runs left to right, the six things sit on it. */
  @media (min-width: 640px) {
    .rail__items {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 12px;
      padding: 26px 0 0;
      border-left: 0;
      position: relative;
    }
    .rail__items::before {
      content: "";
      position: absolute;
      left: 6px;
      right: 6px;
      top: 6px;
      height: 1.5px;
      background: var(--color-letter);
    }
    .rail__item {
      min-width: 0;
    }
    .rail__dot {
      left: 4px;
      top: -26px;
    }
    .rail__what {
      font-size: 15.5px;
      text-wrap: pretty;
    }
  }

  /* 03 — the view: the rail resting on the slab. */
  .outcomes {
    display: grid;
    gap: 14px 22px;
    margin: 22px 0 0;
  }
  @media (min-width: 560px) {
    .outcomes {
      grid-template-columns: 1fr 1fr;
    }
  }
  .outcome dt {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.25;
    color: var(--color-accent);
  }
  .outcome dd {
