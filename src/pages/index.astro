      <PhoneMock
        label="The Story screen: a year of the marriage as a timeline, ending on today's anniversary."
        tab="Story"
        date="Your anniversary"
      >
        <ol class="tl">
          {
            year.timeline.map((t) => (
              <li>
                <span class="tl__year">{t.when}</span>
                <span class:list={["tl__what", t.next && "tl__what--next"]}>
