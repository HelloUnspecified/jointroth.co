                </span>
              </li>
            ))
          }
        </ol>
      </PhoneMock>
    </div>
  </section>

  {/* ------------------------------------------------------------- alts -- */}
  <section class="g-band">
    <div class="g-wrap g-section g-reveal alts" id="alts">
      <div class="alts__intro">
        <Eyebrow tone="tertiary">{alts.eyebrow}</Eyebrow>
        <h2 class="g-h2 alts__h2">{alts.heading}</h2>
      </div>
      <dl class="alts__list">
        {
          alts.items.map((it) => (
            <div class="alt">
              <dt class="alt__have">{it.have}</dt>
              <dd class="alt__answer">{it.answer}</dd>
            </div>
