---
// The homepage, built as a journey. Nobody arrives looking for a place to keep
// their marriage — this is a new idea — so the page has to create the
// recognition before it shows the product. Read top to bottom:
//
//   hero      the hook: a year planning the wedding. Then the marriage just happens.
//             (+ the App Store badge, which opens the coming-soon notice + form)
//   plans     the part nobody plans — nobody builds a marriage on purpose. What if
//             you did? Three scenes they've lived, in their words
//   turn      the new idea: what if your marriage had a place? (and the brand line)
//   app       one place, built in layers: foundation, timeline, the view; how it starts
//   year      where you end up: next anniversary, you read the year back
//   alts      "but we already have…" — iMessage/Photos, Facebook, nothing
//   founders  Clark and Carrie: we lost eighteen years of it
//   sealed    the privacy promise (always Lamplight)
//   faq       six questions
//   closing   this year is happening either way — what it becomes in Troth; the form again
//
// Every form posts { email } to /api/subscribe (the waitlist) and lands on
// /welcome, where the spouse invite lives. Copy lives in the constants below.
import { getCollection } from "astro:content";
import GuideLayout from "../layouts/GuideLayout.astro";
import GuideForm from "../components/guides/GuideForm.astro";
import StickyBar from "../components/guides/StickyBar.astro";
import PhoneMock from "../components/home/PhoneMock.astro";
import AppStoreBadge from "../components/home/AppStoreBadge.astro";
import Eyebrow from "../elements/Eyebrow.astro";
import Button from "../elements/Button.astro";
import LanternMark from "../elements/LanternMark.astro";
import MessageBubble from "../components/troth/MessageBubble.astro";
import QuestionCard from "../components/troth/QuestionCard.astro";
import OnThisDayCard from "../components/troth/OnThisDayCard.astro";
import KeepsakeSeal from "../components/troth/KeepsakeSeal.astro";
import { getSiteNav, getStoryUrl } from "../lib/nav";

const SITE_URL = "https://jointroth.co";

/* ---- the free things, read from their collections so they stay current -- */

const guides = (await getCollection("guides", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const guide = guides[0];
const guideUrl = guide ? `/guides/${guide.id}/` : "/guides/";

const storyUrl = await getStoryUrl();

/* ---- copy --------------------------------------------------------------- */

const hero = {
  eyebrow: "A private iPhone app for married couples",
  sub: "Troth is a private place for the two of you to talk, write down what you're building, keep what matters, and watch the whole story grow, brick by brick.",
  micro:
    "Free to join. No credit card. You'll also get our letter, Brick by Brick. Unsubscribe anytime.",
  facts: [
    "Coming to iPhone",
    "Built for two",
    "Lives in your iCloud, not ours",
  ],
  earlyDesign:
    "Early design. The app is being built with the couples on this list.",
};

// The problem, in their terms. Three scenes they've lived, then the line that
// takes "this is for marriages in trouble" off the table.
const plans = {
  eyebrow: "The part nobody plans",
  heading: "Nobody builds a marriage on purpose. What if you did?",
  lede: "Not because you don't care. Because nobody ever told you a marriage was something you could build. So the best of it slips through.",
  scenes: [
    {
      line: "Twenty years of decisions, none of them written down.",
      body: "Where to live. How to fight. What you'd never do to each other. You decided all of it, out loud, once. Try to find any of it now.",
    },
    {
      line: "The best conversation you ever had, lost in a thread.",
      body: "It's in iMessage, between the carpool and the grocery list, three years deep and sinking.",
    },
    {
      line: "“We should do this more.” Said every year, kept nowhere.",
      body: "The dinner where you felt like a team again. The trip that changed something. You meant to hold onto it. There was nowhere to put it.",
    },
  ],
  turn: "This isn't a marriage in trouble. It's every marriage. Year one or year thirty, small kids or an empty house, a good stretch or a hard one. Ours included.",
  caption:
    "The message that mattered, three years deep in the same thread as the carpool.",
};

// The new idea. The brand line lives here: it's the philosophy behind the turn.
const turn = {
  eyebrow: "A different idea",
  heading: "What if your marriage had a place?",
  body: "Not a scrapbook. Not a therapy app. Not another feed. One private place where the two of you talk, write down what you're building, keep what matters, and can see the whole story as it grows. Built on purpose, a brick at a time.",
  definition: {
    word: "troth",
    meaning:
      "An old word for a pledge, a promise of faithfulness. The root of “betrothed.” I pledge thee my troth.",
  },
};

// The product, in layers. A foundation, a timeline everything runs through,
// and the view you get when one is laid over the other. Then how it starts.
const app = {
  eyebrow: "What Troth is",
  heading: "One place, built in layers.",
  lede: "Troth isn't a list of features. It's a way of seeing your marriage: everything that happens, laid over everything you promised.",
  layers: [
    {
      num: "01",
      name: "The foundation",
      title: "Start with what each of you wants to build.",
      body: "Your vows, your values, your troth. Troth walks the two of you through it with short guided exercises. The first is one sentence, finished separately and then compared: we're building a relationship where we\u2026 You each find out what the other wants to build. Then you choose the lines you'll both stand behind, sign them, and everything else sits on top of them.",
      kinds: ["Vows", "Values", "Troth"],
      offer: {
        lead: "Don't want to wait for the app? The first exercise works on paper.",
        cta: "Get the free exercise",
      },
    },
    {
      num: "02",
      name: "The timeline",
      title: "Everything else runs through one timeline.",
      body: "Messages to each other. Pictures. Places. Letters. Milestones. Events. All of it in the order it actually happened, in a room only the two of you can open, instead of scattered across five apps you're borrowing.",
      kinds: [
        "Messages",
        "Pictures",
        "Places",
        "Letters",
        "Milestones",
        "Events",
      ],
    },
    {
      num: "03",
      name: "The view",
      title: "Lay one over the other, and you can finally see your marriage.",
      body: "When everything you've kept sits on top of everything you promised, you have context. Disconnected, you have five apps and no view. Together, you have one you've never had.",
      outcomes: [
        {
          verb: "Reflect",
          what: "Read the year back against what you set out to do.",
        },
        { verb: "Plan", what: "Set the next twelve months, brick by brick." },
        {
          verb: "Check in",
          what: "A gentle question now and then, answered together.",
        },
        {
          verb: "Work through",
          what: "See a hard season as a chapter, not the whole story.",
        },
      ],
    },
  ],
  rail: [
    { kind: "Message", what: "\u201cRight about the house.\u201d" },
    { kind: "Picture", what: "The lake, first morning" },
    { kind: "Place", what: "Wells Street" },
    { kind: "Letter", what: "Sealed until Oct 12", sealed: true },
    { kind: "Milestone", what: "Twenty years" },
    { kind: "Event", what: "Annual troth" },
  ],
  // The first exercise, as it looks inside the app: each of you alone, then
  // together. Stand-in until a real screenshot goes in PhoneMock's `src`.
  exercise: {
    prompt: "We're building a relationship where we\u2026",
    you: [
      {
        text: "say the hard thing on the same day we think it.",
        starred: true,
      },
      { text: "keep Sunday mornings for no one but us." },
    ],
    them: [
      { text: "apologize before we're finished being right.", starred: true },
      { text: "pick each other on the hard days." },
    ],
    chosen: "say the hard thing on the same day we think it.",
  },
  howEyebrow: "How it starts",
  how: [
    {
      title: "Join the waitlist",
      body: "A few couples at a time in 2026, in order. Clark writes before it's your turn.",
    },
    {
      title: "Invite your spouse",
      body: "Troth only works with the two of you. Nothing starts until you're both in.",
    },
    {
      title: "Seal the room",
      body: "Your two iPhones share one room in your own iCloud. Then you start keeping.",
    },
  ],
};

// Where you end up. Second person, one scene, concrete.
const year = {
  eyebrow: "Where you end up",
  heading: "Next anniversary, you read the year back.",
  paras: [
    "It's the two of you at the table, phones out for once. You open Troth. There are the promises you wrote in September, and the one you actually kept. The message your spouse sealed in March that came back on the day it should. The trip. The hard week in June, and what you decided. The Tuesday you both answered “where did we feel like a team this week” with the same answer.",
    "A year of your marriage, the way it actually happened. Not the highlight reel. The real one.",
    "Then you write the next one.",
  ],
  line: "A marriage you can read back, and keep building.",
  timeline: [
    {
      when: "September",
      what: "We're building a relationship where we… Signed, both of us.",
    },
    {
      when: "March",
      what: "Sealed: “You were right about waiting on the house.”",
    },
    {
      when: "May",
      what: "Most like a team this week? Same answer, both of you.",
    },
    { when: "June", what: "The hard week. What we decided." },
    { when: "Today", what: "Your anniversary. Read it back.", next: true },
  ],
};

// The objection: "we already have…" Three answers, then the borrowed-rooms line.
const alts = {
  eyebrow: "But we already have…",
  heading: "You have the pieces. You don't have the marriage.",
  items: [
    {
      have: "iMessage, Photos and Notes",
      answer:
        "That's where it gets lost. Your marriage is borrowing space in the same thread as the carpool. Storage isn't keeping.",
    },
    {
      have: "Facebook and shared albums",
      answer:
        "That's the highlight reel, made for other people. Troth holds what you'd never post, for the only person who should see it.",
    },
    {
      have: "Honestly, nothing",
      answer:
        "Neither did we, for eighteen years. It's the one thing in your life that never had a place, and the only one you'd grieve losing.",
    },
  ],
  line: "Marriages deserve better than borrowed rooms.",
};

const founders = {
  eyebrow: "Who's building it",
  heading: "We lost eighteen years of it. We're not losing the next twenty.",
  p1: "We're Clark and Carrie Sell, together twenty-six years and married twenty-three. We had a good marriage the whole time, and we still can't tell you what we promised each other in year six, or find the message that mattered in year eleven. Six years as a couple, eighteen as the directors of our kids' lives, and now it's the two of us again. The question that gets under our skin isn't whether it was good. It's what it could have been.",
  p2: "So we're building the tool we wished we'd had, in partnership with the couples on this list, opening access carefully so the first ones are genuinely served by it. When you sign up, Clark writes to you personally. Every reply gets read.",
  cta: "Read where Troth came from",
  photoAlt: "Clark and Carrie Sell.",
};

// Every claim here has to be exactly true of the architecture (CloudKit in the
// couple's own iCloud). See "Privacy claims" in CLAUDE.md and /privacy.
const sealed = {
  eyebrow: "The privacy promise",
  heading: "Sealed for two.",
  body: "Honesty needs a place where it's safe. Everything you put in Troth lives in your own iCloud and syncs between your two iPhones, the way your Photos do. It never touches a server we run. We can't read it, and nothing else is reading it either.",
  facts: [
    {
      title: "In your iCloud, not on our servers",
      body: "Troth has no servers of its own. Your marriage syncs through the iCloud account you already have, under Apple's encryption.",
    },
    {
      title: "Unreadable by us",
      body: "There is no admin view and no back door. Clark and Carrie can't read it, and we don't want to be able to.",
    },
    {
      title: "No AI, no ads, ever",
      body: "Troth doesn't analyze, summarize or suggest, and never sells a thing to anyone. It keeps.",
    },
    {
      title: "Face ID at the door",
      body: "Locked to the two of you. Nothing in the camera roll, nothing in a shared thread.",
    },
  ],
  more: "Turn on Apple's Advanced Data Protection and it's end-to-end encrypted, so even Apple can't read it.",
  link: "How Troth keeps it sealed, in plain English",
};

const faq = {
  eyebrow: "Before you join",
  heading: "The questions people ask.",
  items: [
    {
      q: "When can we use it?",
      a: "Troth comes to iPhone in 2026. We open access to a few couples at a time, in waitlist order, and you'll hear from Clark at least 48 hours before it's your turn.",
    },
    {
      q: "What does it cost?",
      a: "Joining the waitlist costs nothing. We haven't set the number yet, but it won't be a five-dollar app: one price a year for the two of you, more than you expect an app to cost and less than an hour with a counselor. The first couples will help us settle it, and nobody is charged without knowing first.",
      more: { label: "What Troth will cost, and why", href: "/pricing/" },
    },
    {
      q: "Do we both need an iPhone?",
      a: "For now, yes. Troth is being built for iPhone first, and the room only opens when both phones are in it.",
    },
    {
      q: "Is this another thing to keep up with?",
      a: "No. There are no streaks, no scores, and no notifications nagging you. Troth asks a gentle question now and then, and you can say “not today” as often as you like. It's a place, not a program.",
    },
    {
      q: "What if my spouse isn't sure?",
      a: "Join on your own. After you sign up, the next page lets you send your spouse an invite from Clark, or copy the link and send it yourself. Nothing starts until you're both in, and there's no pressure either way.",
    },
    {
      q: "Can you read what we write?",
      a: "No. Troth has no servers of its own. Everything lives in your iCloud, under Apple's encryption, and there is no admin view for us to look through. Turn on Advanced Data Protection and even Apple can't read it. The details are on the privacy page.",
      more: { label: "How Troth keeps it sealed", href: "/privacy/" },
    },
  ],
};

// Bookends the hero ("Then the marriage just happens"): the year is coming
// either way, and this is what it becomes in Troth. Not an archive, a better
// marriage. The last line is the one they can't imagine going back from.
const closing = {
  eyebrow: "Coming to iPhone",
  heading: "This year is happening either way.",
  body: "Spend it in Troth, and by next anniversary:",
  year: [
    {
      label: "Built",
      line: "You know what you're building, because you wrote it down together.",
    },
    { label: "Said", line: "You've said the things that usually wait." },
    {
      label: "Weathered",
      line: "The hard week brought you closer, and you can see how.",
    },
  ],
  lastLead: "And Troth isn't an app you open anymore.",
  lastEm: "It's where your marriage lives.",
  while: "While you wait:",
};

/* ---- structured data ---------------------------------------------------- */

// Organization + WebSite, linked by @id, plus the FAQ. Only claims things
// visible on the page — there is no rating, price, or release date to claim.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    name: "Troth",
    url: SITE_URL,
    logo: {
      "@type": "ImageObject",
      url: `${SITE_URL}/favicon.png`,
      width: 512,
      height: 512,
    },
    description:
      "A private home for your marriage. Built by Clark and Carrie Sell.",
    email: "hello@jointroth.co",
    founder: [
      { "@type": "Person", name: "Clark Sell" },
      { "@type": "Person", name: "Carrie Sell" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    name: "Troth",
    url: SITE_URL,
    description: hero.sub,
    publisher: { "@id": `${SITE_URL}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];

const nav = await getSiteNav();
---

<GuideLayout
  ogType="website"
  jsonLd={jsonLd}
  nav={nav}
  headerCta="Join the waitlist"
  headerCtaHref="#join"
>
  {/* ------------------------------------------------------------- hero -- */}
  <section class="g-wrap hero">
    <div class="hero__copy">
      <Eyebrow tone="accent">{hero.eyebrow}</Eyebrow>
      <h1 class="g-h1 hero__h1">
        A year planning the wedding. Then the marriage just <span class="g-em"
          >happens.</span
        >
      </h1>
      <p class="g-lede hero__sub">{hero.sub}</p>
      <div class="hero__form" id="join">
        <GuideForm
          redirect="/welcome"
          id="hero"
          cta="Join the waitlist"
          microcopy={hero.micro}
          variant="bare"
          inline
        />
      </div>
    </div>

    <div class="hero__visualwrap">
      <div class="hero__visual">
        <div class="hero__glow" aria-hidden="true"></div>
        <PhoneMock
          label="The Troth home screen: an On this day card, a sealed message from your spouse, and a question for the two of you."
        >
          <OnThisDayCard year="2019" title="The apartment on Wells Street">
            One room, almost no furniture, certain of nothing except each other.
          </OnThisDayCard>
          <div class="scr__thread">
            <MessageBubble from="them" initial="C" tone="plum" keepsake>
              You were right about waiting on the house. I'm glad we did.
            </MessageBubble>
            <MessageBubble from="me">Save this one.</MessageBubble>
          </div>
          <QuestionCard
            question="Where did you feel most like a team this week?"
            secondaryLabel="Not today"
          />
        </PhoneMock>
      </div>
      <p class="g-meta hero__early">{hero.earlyDesign}</p>
    </div>

    <div class="hero__foot">
      <AppStoreBadge />
      <ul class="g-facts hero__facts">
        {hero.facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------ plans -- */}
  <section class="g-band">
    <div class="g-wrap g-section g-reveal plans" id="plans">
      <div class="plans__intro">
        <Eyebrow tone="accent">{plans.eyebrow}</Eyebrow>
        <h2 class="g-h2 plans__h2">{plans.heading}</h2>
        <p class="g-lede plans__lede">{plans.lede}</p>
      </div>
      <div class="plans__body">
        <ol class="scenes">
          {
            plans.scenes.map((s) => (
              <li class="scene">
                <p class="scene__line">{s.line}</p>
                <p class="g-body scene__body">{s.body}</p>
              </li>
            ))
          }
        </ol>
        <figure class="thread">
          <div class="thread__label">Where it lives today</div>
          <div class="thread__msgs">
            <MessageBubble
              from="them"
              initial="C"
              tone="neutral"
              class="thread__noise"
            >
              Can you grab milk on the way home
            </MessageBubble>
            <MessageBubble from="me" class="thread__noise">
              Carpool is 3:15 tomorrow, not 3
            </MessageBubble>
            <MessageBubble from="them" initial="C" tone="plum">
              You were right about waiting on the house. I'm glad we did.
            </MessageBubble>
            <MessageBubble from="me" class="thread__noise">
              Did we pay the sitter?
            </MessageBubble>
            <MessageBubble
              from="them"
              initial="C"
              tone="neutral"
              class="thread__noise"
            >
              Grocery list is in Notes
            </MessageBubble>
          </div>
          <figcaption class="g-meta thread__caption">
            {plans.caption}
          </figcaption>
        </figure>
      </div>
      <p class="plans__turn">{plans.turn}</p>
    </div>
  </section>

  {/* ------------------------------------------------------------- turn -- */}
  <section class="g-wrap g-section g-reveal turn" id="turn">
    <div class="turn__inner">
      <Eyebrow tone="tertiary">{turn.eyebrow}</Eyebrow>
      <h2 class="g-h2 turn__h2">{turn.heading}</h2>
      <p class="g-lede turn__body">{turn.body}</p>
      <p class="turn__line">
        Love is more than a feeling. It's what you <span class="g-em">do.</span>
      </p>
      <p class="turn__that">That's Troth.</p>
      <dl class="turn__def">
        <dt>{turn.definition.word}</dt>
        <dd>{turn.definition.meaning}</dd>
      </dl>
    </div>
  </section>

  {/* -------------------------------------------------------------- app -- */}
  <section class="g-band">
    <div class="g-wrap g-section g-reveal app" id="what">
      <div class="app__intro">
        <Eyebrow tone="tertiary">{app.eyebrow}</Eyebrow>
        <h2 class="g-h2 app__h2">{app.heading}</h2>
        <p class="g-lede app__lede">{app.lede}</p>
      </div>

      {/* 01 — the foundation */}
      <div class="layer">
        <div class="layer__copy">
          <div class="layer__name">
            <span class="layer__num">{app.layers[0].num}</span>
            <span class="layer__verb">{app.layers[0].name}</span>
          </div>
          <h3 class="g-h3 layer__h3">{app.layers[0].title}</h3>
          <p class="g-body layer__body">{app.layers[0].body}</p>
          <ul class="kinds">
            {app.layers[0].kinds?.map((k) => <li>{k}</li>)}
          </ul>
          {
            guide && app.layers[0].offer && (
              <p class="tryit">
                {app.layers[0].offer.lead}{" "}
                <a href={guideUrl}>{app.layers[0].offer.cta}</a>
              </p>
            )
          }
        </div>
        <div class="layer__visual layer__visual--phone">
          <PhoneMock
            label="The Foundation screen: the first exercise, each of your lines, and the one chosen together."
            tab="Foundation"
            date="The first exercise"
          >
            <div class="ex">
              <Eyebrow tone="letter">{app.exercise.prompt}</Eyebrow>
              <div class="ex__who">You</div>
              <ul class="ex__lines">
                {
                  app.exercise.you.map((l) => (
                    <li class:list={[l.starred && "is-starred"]}>{l.text}</li>
                  ))
                }
              </ul>
              <div class="ex__who">Your spouse</div>
              <ul class="ex__lines">
                {
                  app.exercise.them.map((l) => (
                    <li class:list={[l.starred && "is-starred"]}>{l.text}</li>
                  ))
                }
              </ul>
              <div class="ex__chosen">
                <span class="ex__chosen-label">Chosen together</span>
                <span class="ex__chosen-text">{app.exercise.chosen}</span>
                <span class="ex__sign">Signed, both of us</span>
              </div>
            </div>
          </PhoneMock>
        </div>
      </div>

      {/* 02 — the timeline */}
      <div class="layer">
        <div class="layer__copy">
          <div class="layer__name">
            <span class="layer__num">{app.layers[1].num}</span>
            <span class="layer__verb">{app.layers[1].name}</span>
          </div>
          <h3 class="g-h3 layer__h3">{app.layers[1].title}</h3>
          <p class="g-body layer__body">{app.layers[1].body}</p>
          <ul class="kinds">
            {app.layers[1].kinds?.map((k) => <li>{k}</li>)}
          </ul>
        </div>
        <div class="layer__visual">
          <div class="rail">
            <div class="rail__label">One timeline</div>
            <ol class="rail__items">
              {
                app.rail.map((r) => (
                  <li class="rail__item">
                    <span class="rail__dot" aria-hidden="true">
                      {r.sealed && <KeepsakeSeal size={22} />}
                    </span>
                    <span class="rail__kind">{r.kind}</span>
                    <span class="rail__what">{r.what}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>

      {/* 03 — the view */}
      <div class="layer layer--view">
        <div class="layer__copy">
          <div class="layer__name">
            <span class="layer__num">{app.layers[2].num}</span>
            <span class="layer__verb">{app.layers[2].name}</span>
          </div>
          <h3 class="g-h3 layer__h3">{app.layers[2].title}</h3>
          <p class="g-body layer__body">{app.layers[2].body}</p>
          <dl class="outcomes">
            {
              app.layers[2].outcomes?.map((o) => (
                <div class="outcome">
                  <dt>{o.verb}</dt>
                  <dd>{o.what}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="layer__visual">
          <div
            class="view"
            role="img"
            aria-label="The timeline laid over the foundation."
          >
            <div class="view__layer view__layer--rail">
              <span class="view__tag">Timeline</span>
              <span class="view__rail" aria-hidden="true">
                {app.rail.map(() => <i />)}
              </span>
            </div>
            <div class="view__layer view__layer--fnd">
              <span class="view__tag">Foundation</span>
              <span class="view__slab" aria-hidden="true"></span>
            </div>
            <div class="view__eq">= a view of your marriage</div>
          </div>
        </div>
      </div>

      <div class="how">
        <Eyebrow tone="tertiary">{app.howEyebrow}</Eyebrow>
        <ol class="how__steps">
          {
