    <div class="founders__copy">
      <Eyebrow tone="tertiary">{founders.eyebrow}</Eyebrow>
      <h2 class="g-h2 founders__h2">{founders.heading}</h2>
      <p class="g-body founders__p">{founders.p1}</p>
      <p class="g-body founders__p">{founders.p2}</p>
      <p class="g-sign">— Clark and Carrie Sell</p>
      <div class="founders__cta">
        <Button variant="secondary" size="medium" href={storyUrl}
          >{founders.cta}</Button
        >
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- sealed -- */}
  <section class="troth-dark g-dark sealed" id="sealed">
    <div class="g-wrap g-section g-reveal sealed__inner">
      <div class="sealed__glow" aria-hidden="true"></div>
      <div class="sealed__lock" aria-hidden="true">
        <svg
          width="30"
          height="30"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--ink)"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="4.5" y="10.5" width="15" height="10" rx="2.4"></rect>
          <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"></path>
          <circle cx="12" cy="14.6" r="1.5"></circle>
          <path d="M12 16.1v2"></path>
        </svg>
      </div>
      <Eyebrow tone="accent" class="sealed__eyebrow">{sealed.eyebrow}</Eyebrow>
      <h2 class="g-h2 sealed__h2">{sealed.heading}</h2>
      <p class="g-lede sealed__body">{sealed.body}</p>
      <dl class="sealed__facts">
        {
          sealed.facts.map((f) => (
            <div class="sealed__fact">
              <dt>{f.title}</dt>
              <dd>{f.body}</dd>
            </div>
          ))
        }
      </dl>
      <p class="g-body sealed__more">{sealed.more}</p>
      <a class="sealed__link" href="/privacy/">{sealed.link}</a>
    </div>
  </section>

  {/* -------------------------------------------------------------- faq -- */}
  <section class="g-wrap g-wrap--narrow g-section g-reveal faq" id="faq">
    <Eyebrow tone="tertiary">{faq.eyebrow}</Eyebrow>
    <h2 class="g-h2 faq__h2">{faq.heading}</h2>
    <dl class="faq__list">
      {
        faq.items.map((item) => (
          <div class="faq__item">
            <dt class="faq__q">{item.q}</dt>
            <dd class="faq__a">
              {item.a}
              {"more" in item && item.more && (
                <a class="faq__more" href={item.more.href}>
                  {item.more.label}
                </a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ---------------------------------------------------------- closing -- */}
  <section class="g-band">
    <div class="g-wrap g-section g-reveal closing">
      <div class="closing__inner">
        <header class="closing__head">
          <div class="closing__mark">
            <LanternMark size={30} tone="brand" />
          </div>
          <Eyebrow tone="tertiary">{closing.eyebrow}</Eyebrow>
          <h2 class="g-h2 closing__h2">{closing.heading}</h2>
          <p class="g-lede closing__body">{closing.body}</p>
        </header>
        <ol class="closing__year">
          {
            closing.year.map((y) => (
              <li>
                <span class="closing__label">{y.label}</span>
                <p class="closing__line">{y.line}</p>
              </li>
            ))
          }
        </ol>
        <p class="g-pull closing__last">
          {closing.lastLead}
          <span class="g-em closing__em">{closing.lastEm}</span>
        </p>
        <div class="closing__form">
          <GuideForm
            redirect="/welcome"
            id="closing"
            cta="Join the waitlist"
            privacy="You'll also get our letter, Brick by Brick. We'll never share your address. Unsubscribe anytime."
            variant="bare"
            inline
          />
        </div>
        <p class="g-meta closing__while">
          {closing.while}{" "}
          <a href={guideUrl}>the free exercise for two</a> ·{" "}
          <a href="/newsletter/">the letter, Brick by Brick</a>
        </p>
        <p class="g-sign closing__sign">— Clark and Carrie</p>
      </div>
    </div>
  </section>

  <StickyBar label="Coming to iPhone." cta="Join the waitlist" href="#join" />
</GuideLayout>

<style>
  /* ------------------------------------------------------------- hero -- */
  /* Type ramp, top to bottom: eyebrow 11 · h1 60 · lede 20 · form 17 · micro 13.
     Nothing else lives in the copy column. */
  .hero {
    /* The glow bleeds past the column on purpose; never past the viewport. */
    overflow-x: clip;
    display: grid;
    gap: clamp(40px, 6vw, 64px);
    padding-block: clamp(36px, 6vw, 72px) clamp(36px, 5vw, 56px);
    align-items: center;
  }
  @media (min-width: 992px) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
      gap: clamp(28px, 4vw, 56px) clamp(48px, 6vw, 96px);
      padding-top: clamp(56px, 6vw, 80px);
    }
    .hero__foot {
      grid-column: 1 / -1;
    }
    /* The phone runs off the bottom of the hero behind a soft fade, so the
       hero's height comes from the copy and the store band, not the device —
       badge included, it clears a 900px fold. */
    .hero__visual {
      height: 440px;
      overflow: clip;
      -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent);
      mask-image: linear-gradient(to bottom, #000 58%, transparent);
    }
  }
  /* Below that the whole device shows, so the last card on its screen fades
     out above the tab row instead of being cut mid-line. */
  @media (max-width: 991px) {
    .hero__visual :global(.pm__body) {
      -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent);
      mask-image: linear-gradient(to bottom, #000 80%, transparent);
    }
  }
  .hero__h1 {
    margin-top: 18px;
    font-size: clamp(38px, 5.6vw, 60px);
    max-width: 15ch;
  }
  .hero__sub {
    margin-top: 22px;
    max-width: 32rem;
    font-size: clamp(18px, 2vw, 20px);
  }
  .hero__form {
    margin-top: 32px;
    max-width: 32rem;
    scroll-margin-top: 90px;
  }

  /* The store band: centered, quiet, the last thing before the fold. */
  .hero__foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding-top: clamp(22px, 3vw, 30px);
    border-top: 1px solid var(--color-border);
  }
  .hero__facts {
    justify-content: center;
  }

  .hero__visual {
    position: relative;
    padding-block: clamp(8px, 2vw, 24px);
  }
  .hero__glow {
    position: absolute;
    inset: -10% -6%;
    background: radial-gradient(
      ellipse 50% 45% at 50% 48%,
      rgba(162, 75, 52, 0.22),
      rgba(162, 75, 52, 0.04) 55%,
      rgba(162, 75, 52, 0) 72%
    );
    filter: blur(24px);
    pointer-events: none;
  }
  .hero__visual :global(.pm) {
    position: relative;
  }
  .hero__visualwrap {
    min-width: 0;
  }
  .hero__early {
    position: relative;
    margin-top: 12px;
    text-align: center;
  }
  .scr__thread {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 6px;
  }
  /* The screen is narrower than the components were drawn for; tighten. */
  .hero__visual :global(.pm__body .btn) {
    padding: 11px 16px;
    font-size: 14px;
  }

  /* ------------------------------------------------------------ plans -- */
  .plans__intro {
    max-width: 40rem;
  }
  .plans__h2 {
    margin-top: 14px;
  }
  .plans__lede {
    margin-top: 16px;
  }
  .plans__body {
    display: grid;
    gap: clamp(34px, 5vw, 64px);
    margin-top: clamp(32px, 5vw, 56px);
    align-items: center;
  }
  @media (min-width: 992px) {
    .plans__body {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
  .scenes {
    list-style: none;
