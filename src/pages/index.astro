  }
  .turn__body {
    margin-top: 20px;
  }
  .turn__line {
    font-family: var(--font-serif);
    font-size: clamp(24px, 3.2vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: clamp(28px, 4vw, 40px) 0 0;
    text-wrap: balance;
  }
  .turn__that {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--color-text-secondary);
    margin: 12px 0 0;
  }
  .turn__def {
    margin: clamp(28px, 4vw, 40px) 0 0;
