      </dl>
      <p class="alts__line">{alts.line}</p>
    </div>
  </section>

  {/* --------------------------------------------------------- founders -- */}
  <section class="g-wrap g-section g-split g-reveal founders" id="founders">
    <figure class="g-figure founders__photo">
      <img
        src="/newsletter/clark-and-carrie.jpg"
